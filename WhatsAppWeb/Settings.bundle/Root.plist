<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Notifications</string>
			<key>FooterText</key>
			<string>Keeps WhatsApp connected after you leave the app so new messages still notify you. It plays inaudible audio to stay awake, which uses more battery. Audio is mixed with other apps by default, so music keeps playing; if another app's sound still stops, turn mixing off. Tip: shake the phone inside the app for more options.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Stay connected in background</string>
			<key>Key</key>
			<string>keepAlive</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Mix with other audio</string>
			<key>Key</key>
			<string>mixAudio</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
